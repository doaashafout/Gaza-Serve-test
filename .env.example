# ===== GazaServe Bot — Environment Variables =====

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gazaserve
DB_USER=root
DB_PASS=

# OpenAI (optional — AI category detection)
OPENAI_API_KEY=your_openai_api_key_here

# Server
PORT=5050
SERVER_URL=https://your-domain.com
NODE_ENV=development

# Admin Telegram ID (get with /myid command)
ADMIN_ID=123456789
